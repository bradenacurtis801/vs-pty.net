<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>bradenacurtis801.Pty.Net</PackageId>
    <Version>1.0.2</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(WinptyReleasePath)\x64\*.dll;$(WinptyReleasePath)\x64\*.exe">
      <Visible>false</Visible>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="$(OpenConsoleReleasePath)\x64\Release\*.dll;$(OpenConsoleReleasePath)\x64\Release\*.exe">
      <Visible>false</Visible>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <LinkBase>os64\</LinkBase>
    </None>

    <None Include="Pty.Net.targets">
      <Pack>true</Pack>
      <PackagePath>build\bradenacurtis801.Pty.Net.targets</PackagePath>
    </None>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />

    <!-- Pre-built native libraries staged by CI or a prior local build -->
    <None Include="../Pty.Net.Native/output/runtimes/osx-arm64/native/libpty_net.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/"
          Condition="Exists('../Pty.Net.Native/output/runtimes/osx-arm64/native/libpty_net.dylib')" />
    <None Include="../Pty.Net.Native/output/runtimes/osx-x64/native/libpty_net.dylib"
          Pack="true" PackagePath="runtimes/osx-x64/native/"
          Condition="Exists('../Pty.Net.Native/output/runtimes/osx-x64/native/libpty_net.dylib')" />
    <None Include="../Pty.Net.Native/output/runtimes/linux-x64/native/libpty_net.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/"
          Condition="Exists('../Pty.Net.Native/output/runtimes/linux-x64/native/libpty_net.so')" />
    <None Include="../Pty.Net.Native/output/runtimes/linux-arm64/native/libpty_net.so"
          Pack="true" PackagePath="runtimes/linux-arm64/native/"
          Condition="Exists('../Pty.Net.Native/output/runtimes/linux-arm64/native/libpty_net.so')" />
  </ItemGroup>
  
  <Target Name="BuildNativeShim" BeforeTargets="AssignTargetPaths"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <_NativeSourceDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Pty.Net.Native'))</_NativeSourceDir>
      <_ProcessArch>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)</_ProcessArch>
      <_NativeArch Condition="'$(_ProcessArch)' == 'Arm64'">arm64</_NativeArch>
      <_NativeArch Condition="'$(_ProcessArch)' == 'X64'">x64</_NativeArch>
      <_NativeRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-$(_NativeArch)</_NativeRid>
      <_NativeRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-$(_NativeArch)</_NativeRid>
      <_NativeLibExt Condition="$([MSBuild]::IsOSPlatform('OSX'))">dylib</_NativeLibExt>
      <_NativeLibExt Condition="$([MSBuild]::IsOSPlatform('Linux'))">so</_NativeLibExt>
      <_NativeBuildDir>$(BaseIntermediateOutputPath)native/$(_NativeRid)</_NativeBuildDir>
      <_NativeLibFile>$(_NativeBuildDir)/bin/libpty_net.$(_NativeLibExt)</_NativeLibFile>
      <_NativeStagedDir>$(_NativeSourceDir)/output/runtimes/$(_NativeRid)/native</_NativeStagedDir>
    </PropertyGroup>

    <MakeDir Directories="$(_NativeBuildDir);$(_NativeStagedDir)" />

    <Exec Command="cmake -DCMAKE_BUILD_TYPE=Release &quot;$(_NativeSourceDir)&quot;"
          WorkingDirectory="$(_NativeBuildDir)"
          Condition="!Exists('$(_NativeBuildDir)/CMakeCache.txt')" />

    <Exec Command="cmake --build . --config Release"
          WorkingDirectory="$(_NativeBuildDir)" />

    <!-- Stage into output/runtimes/ so the static None Pack items above find it -->
    <Copy SourceFiles="$(_NativeLibFile)" DestinationFolder="$(_NativeStagedDir)" />

    <ItemGroup>
      <Content Include="$(_NativeLibFile)" CopyToOutputDirectory="PreserveNewest">
        <Link>libpty_net.$(_NativeLibExt)</Link>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="CollectNugetFiles" BeforeTargets="_GetPackageFiles"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <OutputPtyFiles Include="$(RepoRootPath)\bin\winpty\**\*" />
      
      <None Include="@(OutputPtyFiles)" Condition="'@(OutputPtyFiles)' != ''">
        <Pack>true</Pack>
        <PackagePath>build\</PackagePath>
      </None>

      <None Include="$(RepoRootPath)\bin\conpty\x86\conpty.dll"
            Condition="Exists('$(RepoRootPath)\bin\conpty\x86\conpty.dll')">
        <Pack>true</Pack>
        <PackagePath>build\x86\os86</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x86\conpty.dll"
            Condition="Exists('$(RepoRootPath)\bin\conpty\x86\conpty.dll')">
        <Pack>true</Pack>
        <PackagePath>build\x86\os64</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x86\OpenConsole.exe"
            Condition="Exists('$(RepoRootPath)\bin\conpty\x86\OpenConsole.exe')">
        <Pack>true</Pack>
        <PackagePath>build\x86\os86</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x64\OpenConsole.exe"
            Condition="Exists('$(RepoRootPath)\bin\conpty\x64\OpenConsole.exe')">
        <Pack>true</Pack>
        <PackagePath>build\x86\os64</PackagePath>
      </None>

      <None Include="$(RepoRootPath)\bin\conpty\x64\conpty.dll"
            Condition="Exists('$(RepoRootPath)\bin\conpty\x64\conpty.dll')">
        <Pack>true</Pack>
        <PackagePath>build\x64\os86</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x64\conpty.dll"
            Condition="Exists('$(RepoRootPath)\bin\conpty\x64\conpty.dll')">
        <Pack>true</Pack>
        <PackagePath>build\x64\os64</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x86\OpenConsole.exe"
            Condition="Exists('$(RepoRootPath)\bin\conpty\x86\OpenConsole.exe')">
        <Pack>true</Pack>
        <PackagePath>build\x64\os86</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x64\OpenConsole.exe"
            Condition="Exists('$(RepoRootPath)\bin\conpty\x64\OpenConsole.exe')">
        <Pack>true</Pack>
        <PackagePath>build\x64\os64</PackagePath>
      </None>
    </ItemGroup>
  </Target>
</Project>
